{
  "name": "zeiglerd/zeiglerd.com",
  "version": "0.0.2",
  "type": "project",
  "scripts": {
    "build:local": "composer engine build:local",
    "build:dev": "composer engine build:dev",
    "build:qa": "composer engine build:qa",
    "build:prod": "composer engine build:prod",
    "deploy:dev": "composer engine deploy:dev",
    "deploy:qa": "composer engine deploy:qa",
    "deploy:prod": "composer engine deploy:prod",
    "dev:local": [ "Composer\\Config::disableProcessTimeout", "composer engine dev:local" ],
    "dev:dev": [ "Composer\\Config::disableProcessTimeout", "composer engine dev:dev" ],
    "dev:qa": [ "Composer\\Config::disableProcessTimeout", "composer engine dev:qa" ],
    "dev:prod": [ "Composer\\Config::disableProcessTimeout", "composer engine dev:prod" ],
    "engine": [ "Composer\\Config::disableProcessTimeout", "cd ./vendor/zeiglerd/php-engine/ && composer" ],
    "grunt": "cd ./vendor/zeiglerd/php-engine/ && npx grunt",
    "post-install-cmd": "composer engine post-install-hook",
    "post-update-cmd": "composer engine post-update-hook",
    "pre-install-cmd": "[ -d ./vendor/zeiglerd/php-engine/ ] && (composer engine pre-install-hook) || echo >nul",
    "pre-update-cmd": "[ -d ./vendor/zeiglerd/php-engine/ ] && (composer engine pre-update-hook) || echo >nul",
    "test": "./vendor/bin/phpunit/ tests"
  },
  "autoload": {
    "psr-4": {
      "ZeiglerD\\ZeiglerD\\": "src/",
      "ZeiglerD\\ZeiglerD\\UnitTests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Dustin Zeigler"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/zeiglerd/php-engine.git"
    }
  ],
  "require": {
    "zeiglerd/php-engine": "dev-dev"
  }
}
